<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_installation_sheet" model="report.paperformat">
        <field name="name">Installation Sheet A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_installation_sheet" model="ir.actions.report">
        <field name="name">Installation Sheet</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_installation_sheet.report_installation_sheet</field>
        <field name="report_file">sale_installation_sheet.report_installation_sheet</field>
        <field name="print_report_name">'Installation Sheet - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_installation_sheet"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
